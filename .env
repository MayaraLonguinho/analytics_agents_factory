# Platform Runtime
APP_ENV=development
LOG_LEVEL=INFO

# LLM Providers - API Keys (Não inserir secrets reais, configure no ambiente)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# LLM Providers - Models
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-1.5-pro
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620