# Platform Runtime
APP_ENV=development
LOG_LEVEL=INFO

# LLM Providers - API Keys (Não inserir secrets reais no .env local, configure-os com segurança)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Providers - Models Suportados Pelo LLM Gateway
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-1.5-pro
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620