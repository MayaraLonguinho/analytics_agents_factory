# ==========================================
# Analytics Agents Factory - Configuration
# ==========================================

# --- LLM Provider Settings ---
# Provedor atual suportado e funcional: openai
# (Anthropic e Gemini intencionalmente configurados para disparar NotImplementedError nesta versão)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
OPENAI_API_KEY=your_openai_api_key_here

# --- Runtime Configuration ---
MAX_REPAIR_ATTEMPTS=3

# --- Paths ---
# O diretório materializado final. Por convenção: /e_generated_projects
# PROJECT_OUTPUT_DIR=
